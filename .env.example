# Copia este archivo como .env y complétalo con tus valores reales.
# El archivo .env NUNCA debe subirse a Git (debe estar en .gitignore).

# Obligatorio: token de aplicación de Socrata (Datos Abiertos Colombia)
SOCRATA_APP_TOKEN=

# Opcionales (tienen valores por defecto en el código)
SECOP_API_BASE_URL=https://www.datos.gov.co/resource
SECOP_DATASET_ID=rpmr-utcd
SECOP_PAGE_SIZE=5000
SECOP_RAW_DIR=data/raw/secop_ii
SECOP_CHECKPOINT_PATH=data/raw/_checkpoints/last_extraction.json
